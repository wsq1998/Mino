{
  "name": "mio-desktop-pet",
  "version": "2.15.0",
  "description": "Mio - macOS desktop companion robot",
  "main": "main.js",
  "author": "Kaven",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wsq1998/Mino.git"
  },
  "scripts": {
    "start": "electron . --no-sandbox",
    "test": "node --test test/*.test.js",
    "autotest": "MIO_AUTOTEST=1 electron .",
    "pack": "electron-builder --mac --dir",
    "dist": "electron-builder --mac dmg zip"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.kaven.mio",
    "productName": "Mio",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**",
      "main/core/**",
      "main/clean/**",
      "main/system/**",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.utilities",
      "identity": null,
      "icon": "build/icon.png",
      "extendInfo": { "LSUIElement": true },
      "target": ["dmg", "zip"]
    },
    "dmg": {
      "title": "Mio",
      "window": { "width": 480, "height": 320 }
    }
  }
}
